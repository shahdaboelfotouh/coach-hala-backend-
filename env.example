# ── Supabase ──
# Get these from: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ── Resend (email service) ──
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here

# ── URLs ──
# Your Vercel frontend URL (no trailing slash)
SITE_URL=https://coach-hala-website.vercel.app
# Your Railway backend URL (no trailing slash) — fill in after deploying to Railway
BACKEND_URL=https://coach-hala-backend.railway.app

# ── Admin secret (used to protect /bookings and /block endpoints) ──
# Change this to something only you know
ADMIN_SECRET=hala-admin-2025
